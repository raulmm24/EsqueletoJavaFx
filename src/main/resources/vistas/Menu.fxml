<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" prefHeight="500.0" prefWidth="800.0"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.iesalandalus.programacion.javafx.controladores.MenuControlador"
           stylesheets="@../estilos/menu.css">

    <BorderPane styleClass="main-dashboard">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15;">
                <Button text="☰" onAction="#toggleMenu" styleClass="hamburger-button" />
                <Label text="FotoFilm" styleClass="logo-text" />
            </HBox>
        </top>
        <center>
            <VBox alignment="CENTER" spacing="10">
                <Label text="Bienvenido al Estudio" styleClass="welcome-title" />
            </VBox>
        </center>
    </BorderPane>

    <AnchorPane fx:id="sidebar" maxWidth="200.0" translateX="-200.0"
                StackPane.alignment="CENTER_LEFT"
                styleClass="sidebar-container">
        <VBox spacing="15" layoutY="80.0" prefWidth="200.0" style="-fx-padding: 20;">
            <Button text="👤 Clientes" onAction="#abrirClientes" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📷 Sesiones" onAction="#abrirSesiones" styleClass="nav-button" maxWidth="Infinity"/>
            <Separator styleClass="nav-separator" />
            <Button text="✖ Salir" onAction="#salir" styleClass="nav-button-exit" maxWidth="Infinity"/>
        </VBox>
    </AnchorPane>
</StackPane>